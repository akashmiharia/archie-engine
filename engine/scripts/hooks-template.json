{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 __CLAUDE_DIR__/hooks/guard-tier-1.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [ { "type": "command", "command": "bash __CLAUDE_DIR__/hooks/session-orient.sh", "timeout": 30 } ]
      },
      {
        "matcher": "clear",
        "hooks": [ { "type": "command", "command": "bash __CLAUDE_DIR__/hooks/session-orient.sh", "timeout": 30 } ]
      },
      {
        "matcher": "compact",
        "hooks": [ { "type": "command", "command": "bash __CLAUDE_DIR__/hooks/session-orient.sh", "timeout": 30 } ]
      }
    ]
  }
}
